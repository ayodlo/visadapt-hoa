DATABASE_URL="postgresql://user:pass@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
NEXT_PUBLIC_APP_URL=https://account.portalhoa.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Portal HOA <noreply@notifications.portalhoa.com>
# S3 object storage. Used for event feature images (lib/s3.ts + /api/events/[id]/image).
# The bucket stays PRIVATE — images are served through short-lived presigned URLs, so
# no public-read bucket policy is needed. AWS_S3_BUCKET must name a bucket that actually
# exists in AWS_REGION, or uploads fail with NoSuchBucket and the UI reports the error.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# One-off vars for `npm run create-super-admin` (bootstraps/promotes an engineer-only
# SUPER_ADMIN account) — pass inline on the command line, don't store these here:
#   SUPER_ADMIN_EMAIL=you@example.com SUPER_ADMIN_PASSWORD=... npm run create-super-admin
# Optional: SUPER_ADMIN_FIRST_NAME, SUPER_ADMIN_LAST_NAME

# Stripe Connect (payments). TEST-MODE keys only until go-live is approved.
# Express connected accounts: the platform account is the client's, and each HOA is
# onboarded beneath it via POST /api/admin/communities/[id]/stripe. Charges are
# created ON the connected account (direct charges), so the HOA is merchant of
# record and its own statement descriptor appears on the resident's bank line.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_TEST_KEY
# From `stripe listen` locally, or the endpoint's signing secret in the Dashboard.
# The webhook is the ONLY writer of payment records — without this var
# /api/webhooks/stripe answers 503 and no payment is ever recorded.
# The endpoint must be subscribed to CONNECT events (events from connected
# accounts), not just account events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# account.updated.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# Shared secret for the autopay run at POST /api/cron/autopay, sent as
# `Authorization: Bearer <CRON_SECRET>`. No user is present on that request, so this
# stands in for a session; the route is exempted from proxy.ts JWT gating.
# Once deployed, wire it to a daily Vercel Cron entry — no new dependency needed.
# Until then the run can be invoked by hand; add ?dryRun=1 to see what WOULD be
# charged without calling Stripe.
CRON_SECRET=change_me_to_a_long_random_secret
