# S3 object storage. Used for event feature images (lib/s3.ts + /api/events/[id]/image).
# The bucket stays PRIVATE — images are served through short-lived presigned URLs, so
# no public-read bucket policy is needed. AWS_S3_BUCKET must name a bucket that actually
# exists in AWS_REGION, or uploads fail with NoSuchBucket and the UI reports the error.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# One-off vars for `npm run create-super-admin` (bootstraps/promotes an engineer-only
# SUPER_ADMIN account) — pass inline on the command line, don't store these here:
#   SUPER_ADMIN_EMAIL=you@example.com SUPER_ADMIN_PASSWORD=... npm run create-super-admin
# Optional: SUPER_ADMIN_FIRST_NAME, SUPER_ADMIN_LAST_NAME
